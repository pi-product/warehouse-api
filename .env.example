# Server
PORT=3000

# Stone3PL (CN)
STONE3PL_API_URL=https://api.stone3pl.com
STONE3PL_APP_KEY=your_app_key_here
STONE3PL_APP_SECRET=your_app_secret_here
STONE3PL_WAREHOUSE_ID=your_warehouse_id_here
STONE3PL_ENABLED=true

# ShipBob (US)
SHIPBOB_API_URL=https://api.shipbob.com/1.0
SHIPBOB_PAT=your_personal_access_token_here
SHIPBOB_ENABLED=true

# ShipMonk (US) — coming soon
SHIPMONK_API_URL=https://api.shipmonk.com
SHIPMONK_LOGIN=your_login_here
SHIPMONK_TOKEN=your_token_here
SHIPMONK_ENABLED=false

# ShipTop (CA) — coming soon
SHIPTOP_API_URL=https://api.shiptop.com
SHIPTOP_API_KEY=your_api_key_here
SHIPTOP_ENABLED=false

# ChinaDivision (CN) — OAuth 2.0 bearer token, auto-refreshed every 2 hours
CHINADIVISION_API_URL=https://api.chinadivision.com
CHINADIVISION_APP_ID=your_app_id_here
CHINADIVISION_APP_SECRET=your_app_secret_here
CHINADIVISION_WAREHOUSE_ID=your_warehouse_id_here
CHINADIVISION_ENABLED=false
